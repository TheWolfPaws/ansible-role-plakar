# {{ ansible_managed }}
[Unit]
Description=Sauvegarde Plakar de la source %i
OnFailure=plakar-failure@%p-%i.service

[Service]
Type=oneshot
User={{ plakar_user }}
Group={{ plakar_group }}
ExecStart=plakar -keyfile %d/kloset.key at @${KLOSET_NAME} backup -job %i -ignore-file {{ plakar_ignore_dir }}/%i.ignore @%i
ExecStartPost={{ plakar_libexec_dir }}/plakar-backup-errors %d/kloset.key ${KLOSET_NAME} %i %p-%i
