# {{ ansible_managed }}
[Unit]
Description=Sauvegarde Plakar
OnFailure=plakar-failure@%N.service

[Service]
Type=oneshot
User={{ plakar_user }}
Group={{ plakar_group }}
{% for kloset in plakar_fact_klosets %}
{% set name = kloset.name | default(kloset.path | basename) %}
LoadCredential={{ name }}.key:{{ plakar_keyfile_dir }}/{{ name }}.key
{% for source in kloset.sources | default([]) %}
ExecStart=plakar -keyfile %d/{{ name }}.key at {{ kloset.path }} backup {{ source }}
{% endfor %}
{% endfor %}
