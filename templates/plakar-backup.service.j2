# {{ ansible_managed }}
[Unit]
Description=Sauvegarde Plakar de chaque source
{% for source in plakar_sources %}
Wants=plakar-backup@{{ source.name }}.service
After=plakar-backup@{{ source.name }}.service
{% endfor %}
{% for kloset in plakar_fact_klosets_to_sync %}
Wants=plakar-sync@{{ kloset.name }}.service
{% endfor %}

[Service]
Type=oneshot
ExecStart=true
