# {{ ansible_managed }}
[Unit]
Description=Création du Kloset Plakar %i

[Service]
Type=oneshot
User={{ plakar_user }}
Group={{ plakar_group }}
LoadCredential=kloset.key:/etc/credstore/%i.key
ExecCondition=/bin/sh -c '! plakar -keyfile %d/kloset.key at @%i info >/dev/null'
ExecStart=plakar -keyfile %d/kloset.key at @%i create
